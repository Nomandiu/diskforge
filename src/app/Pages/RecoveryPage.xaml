<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DiskForge.Pages.RecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DiskForge.VMs"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header / controls -->
        <StackPanel Grid.Row="0" Margin="28,20,28,8" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE8E5;" FontSize="24"/>
                <TextBlock Text="File recovery" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Recover deleted or lost files from any disk, partition, or unallocated space. Files are copied to a folder you choose — never recovered onto the same disk."
                       Opacity="0.7" TextWrapping="Wrap" MaxWidth="950"/>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Source:" VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch"/>
                <CheckBox x:Name="DeletedCheck" Grid.Column="2" Content="Deleted files" IsChecked="True"
                          VerticalAlignment="Center"/>
                <CheckBox x:Name="CarveCheck" Grid.Column="3" Content="Deep scan (carving)" IsChecked="False"
                          VerticalAlignment="Center"/>
                <Button x:Name="ScanButton" Grid.Column="4" Content="&#xE721;  Scan" Click="ScanButton_Click"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <ProgressRing x:Name="ScanRing" Width="22" Height="22" Visibility="Collapsed"/>
                    <TextBlock x:Name="ScanStatusText" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center"/>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search by name or path..."
                                QuerySubmitted="SearchBox_QuerySubmitted" TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="CategoryCombo" Grid.Column="2" SelectedIndex="0" MinWidth="130">
                    <ComboBoxItem Content="All types"/>
                    <ComboBoxItem Content="Documents"/>
                    <ComboBoxItem Content="Photos"/>
                    <ComboBoxItem Content="Videos"/>
                    <ComboBoxItem Content="Audio"/>
                    <ComboBoxItem Content="Archives"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
                <TextBlock x:Name="ResultCount" Grid.Column="3" VerticalAlignment="Center" Opacity="0.7"/>
                <Button x:Name="RecoverButton" Grid.Column="4" Content="&#xE8E5;  Recover selected..."
                        Click="RecoverButton_Click" Style="{StaticResource OpButton}"/>
            </Grid>
        </StackPanel>

        <!-- results -->
        <ListView x:Name="FilesList" Grid.Row="1" Margin="28,4,28,16" SelectionMode="Extended"
                  IsMultiSelectCheckBoxEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileVM">
                    <Grid ColumnSpacing="14" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="17"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Path, Mode=OneWay}" Opacity="0.55" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind Category, Mode=OneWay}" VerticalAlignment="Center"
                                   Opacity="0.7"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border CornerRadius="3" Padding="6,2" Visibility="{x:Bind DeletedVis, Mode=OneWay}"
                                    Background="#66D13438">
                                <TextBlock FontSize="11" Text="deleted"/>
                            </Border>
                            <Border CornerRadius="3" Padding="6,2" Visibility="{x:Bind BadgeVis, Mode=OneWay}"
                                    Background="#668764B8">
                                <TextBlock FontSize="11" Text="{x:Bind TypeName, Mode=OneWay}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
