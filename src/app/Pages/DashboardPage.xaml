<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DiskForge.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DiskForge.VMs"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="28,20,28,28" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">

            <TextBlock Text="Storage devices" Style="{StaticResource SectionHeaderText}"/>
            <TextBlock x:Name="SummaryText" Opacity="0.7" Text="Scanning..."/>

            <Button x:Name="RescanButton" Content="&#xE72C;  Rescan" Click="RescanButton_Click"/>

            <ListView x:Name="DisksList" SelectionMode="Single" IsItemClickEnabled="True"
                      ItemClick="DisksList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiskVM">
                        <Grid Padding="8,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontSize="30" VerticalAlignment="Center">
                                <FontIcon.Foreground>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                                </FontIcon.Foreground>
                            </FontIcon>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Opacity="0.65" FontSize="12.5"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border CornerRadius="3" Padding="6,2" Background="{ThemeResource CardBackgroundBrush}">
                                        <TextBlock FontSize="11" Text="{x:Bind SizeText, Mode=OneWay}"/>
                                    </Border>
                                    <Border CornerRadius="3" Padding="6,2" Background="{ThemeResource CardBackgroundBrush}">
                                        <TextBlock FontSize="11" Text="{x:Bind StyleText, Mode=OneWay}"/>
                                    </Border>
                                    <Border x:Name="SysBadge" CornerRadius="3" Padding="6,2"
                                            Visibility="{x:Bind SystemVis, Mode=OneWay}">
                                        <TextBlock FontSize="11" Text="System"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" Opacity="0.4" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>
