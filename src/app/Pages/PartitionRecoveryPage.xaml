<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DiskForge.Pages.PartitionRecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DiskForge.VMs"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,20,28,8" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE90F;" FontSize="24"/>
                <TextBlock Text="Partition recovery" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Scan a disk for deleted or lost partitions (deleted entries, damaged partition tables). Found partitions can be restored to the partition table with their data intact."
                       Opacity="0.7" TextWrapping="Wrap" MaxWidth="950"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="28,8,28,12" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Disk:" VerticalAlignment="Center"/>
            <ComboBox x:Name="DiskCombo" MinWidth="320"/>
            <CheckBox x:Name="FullScanCheck" Content="Full (sector-by-sector) scan" VerticalAlignment="Center"/>
            <Button x:Name="ScanButton" Content="&#xE721;  Scan for lost partitions" Click="ScanButton_Click"/>
            <Button x:Name="RepairGptButton" Content="&#xE90F;  Repair GPT structures" Click="RepairGptButton_Click"/>
            <ProgressRing x:Name="ScanRing" Width="22" Height="22" Visibility="Collapsed"/>
            <TextBlock x:Name="ScanStatusText" VerticalAlignment="Center"/>
        </StackPanel>

        <ListView x:Name="ResultsList" Grid.Row="2" Margin="28,0,28,16">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LostPartitionVM">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind LabelText, Mode=OneWay}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{x:Bind FsText, Mode=OneWay}" Opacity="0.7"/>
                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Border CornerRadius="3" Padding="6,2" Background="#660078D4">
                                        <TextBlock FontSize="11" Text="{x:Bind ConfidenceText, Mode=OneWay}"/>
                                    </Border>
                                    <Border CornerRadius="3" Padding="6,2" Background="#66D13438"
                                            Visibility="{x:Bind OverlapVis, Mode=OneWay}">
                                        <TextBlock FontSize="11" Text="overlaps existing"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind PositionText, Mode=OneWay}" Style="{StaticResource MonoText}" Opacity="0.7"/>
                                <TextBlock Text="{x:Bind EvidenceText, Mode=OneWay}" Opacity="0.55" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Restore partition" DataContext="{x:Bind}" Click="RestoreButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
