<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DiskForge.Pages.OperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DiskForge.VMs"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,20,28,8" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE9D5;" FontSize="24"/>
                <TextBlock Text="Operations" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="History of executed operations. DiskForge applies operations one at a time and verifies the result after each step."
                       Opacity="0.7" MaxWidth="950" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="28,4,28,12" Orientation="Horizontal" Spacing="10">
            <Button x:Name="CancelButton" Content="&#xE711;  Cancel current operation" Click="CancelButton_Click"/>
            <Button x:Name="ClearButton" Content="Clear history" Click="ClearButton_Click"/>
            <ProgressRing x:Name="BusyRing" Width="22" Height="22" Visibility="Collapsed"/>
            <TextBlock x:Name="BusyText" VerticalAlignment="Center"/>
        </StackPanel>

        <ListView x:Name="OpsList" Grid.Row="2" Margin="28,0,28,16">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OperationVM">
                    <Grid ColumnSpacing="14" Padding="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9D5;" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Target, Mode=OneWay}" Opacity="0.65"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing Width="18" Height="18" Visibility="{x:Bind RunningVis, Mode=OneWay}"
                                          IsActive="True"/>
                            <FontIcon Glyph="&#xE73E;" Visibility="{x:Bind DoneVis, Mode=OneWay}" Foreground="#4CC2FF"/>
                            <FontIcon Glyph="&#xE711;" Visibility="{x:Bind FailedVis, Mode=OneWay}" Foreground="#FF6B70"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
