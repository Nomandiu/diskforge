<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DiskForge.Pages.DiskDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DiskForge.VMs"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Margin="28,20,28,28" Spacing="14" MaxWidth="1200" HorizontalAlignment="Stretch">

                <!-- header -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7C1;" FontSize="26"/>
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="DiskTitle" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DiskSubtitle" Opacity="0.65" FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- info cards -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Capacity" Style="{StaticResource MetricCaptionText}"/>
                            <TextBlock x:Name="CapacityText" Style="{StaticResource MetricValueText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Partition table" Style="{StaticResource MetricCaptionText}"/>
                            <TextBlock x:Name="StyleText" Style="{StaticResource MetricValueText}"/>
                            <TextBlock x:Name="GuidText" Style="{StaticResource MonoText}" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Sectors" Style="{StaticResource MetricCaptionText}"/>
                            <TextBlock x:Name="SectorText" Style="{StaticResource MetricValueText}"/>
                            <TextBlock x:Name="SectorSizeText" Style="{StaticResource MetricCaptionText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Interface" Style="{StaticResource MetricCaptionText}"/>
                            <TextBlock x:Name="BusText" Style="{StaticResource MetricValueText}"/>
                            <TextBlock x:Name="SerialText" Style="{StaticResource MetricCaptionText}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- partition map -->
                <TextBlock Text="Partition layout" Style="{StaticResource SectionHeaderText}"/>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel Spacing="10">
                        <Grid x:Name="MapHost" Height="64" SizeChanged="MapHost_SizeChanged"/>
                        <TextBlock x:Name="MapHint" Text="Click a partition or unallocated area to select it"
                                   Opacity="0.55" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- partition list -->
                <ListView x:Name="PartsList" SelectionMode="Single"
                          SelectionChanged="PartsList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PartitionVM">
                            <Grid Padding="6,8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="14" Height="14" RadiusX="3" RadiusY="3"
                                           Fill="{x:Bind FillBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind KindText, Mode=OneWay}" Opacity="0.6" FontSize="11.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12.5"/>
                                    <TextBlock Text="{x:Bind StartText, Mode=OneWay}" Opacity="0.5" FontSize="11.5"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- operations -->
                <TextBlock Text="Operations" Style="{StaticResource SectionHeaderText}" Margin="0,10,0,0"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CreateButton" Content="&#xE710;  Create partition" Style="{StaticResource OpButton}" Click="CreateButton_Click"/>
                            <Button x:Name="DeleteButton" Content="&#xE74D;  Delete" Style="{StaticResource OpButton}" Click="DeleteButton_Click"/>
                            <Button x:Name="FormatButton" Content="&#xE9F9;  Format" Style="{StaticResource OpButton}" Click="FormatButton_Click"/>
                            <Button x:Name="ResizeMoveButton" Content="&#xE8CB;  Resize / move" Style="{StaticResource OpButton}" Click="ResizeMoveButton_Click"/>
                            <Button x:Name="SplitButton" Content="&#xE8C8;  Split" Style="{StaticResource OpButton}" Click="SplitButton_Click"/>
                            <Button x:Name="MergeButton" Content="&#xE8F4;  Merge into..." Style="{StaticResource OpButton}" Click="MergeButton_Click"/>
                            <Button x:Name="AllocateButton" Content="&#xE916;  Allocate free space" Style="{StaticResource OpButton}" Click="AllocateButton_Click"/>
                            <Button x:Name="OneClickButton" Content="&#xE8A5;  1-click extend" Style="{StaticResource OpButton}" Click="OneClickButton_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LabelButton" Content="Set label" Style="{StaticResource OpButton}" Click="LabelButton_Click"/>
                            <Button x:Name="LetterButton" Content="Change letter" Style="{StaticResource OpButton}" Click="LetterButton_Click"/>
                            <Button x:Name="ActiveButton" Content="Set active" Style="{StaticResource OpButton}" Click="ActiveButton_Click"/>
                            <Button x:Name="HideButton" Content="Hide / unhide" Style="{StaticResource OpButton}" Click="HideButton_Click"/>
                            <Button x:Name="TypeButton" Content="Change type ID" Style="{StaticResource OpButton}" Click="TypeButton_Click"/>
                            <Button x:Name="ExploreButton" Content="Open in Explorer" Style="{StaticResource OpButton}" Click="ExploreButton_Click"/>
                            <Button x:Name="InitButton" Content="Initialize disk (GPT/MBR)" Style="{StaticResource OpButton}" Click="InitButton_Click"/>
                            <Button x:Name="RecoverFilesButton" Content="&#xE8E5;  Recover files" Style="{StaticResource OpButton}" Click="RecoverFilesButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="InfoBar" IsOpen="False" IsClosable="True"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
