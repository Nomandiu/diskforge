<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiskForge.Dialogs.MergeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" MinWidth="480">
        <TextBlock x:Name="InfoText" Opacity="0.75" TextWrapping="Wrap"/>
        <TextBlock Text="Partition to merge (its files are copied into a folder, then it is removed):"/>
        <ComboBox x:Name="SourceCombo" MinWidth="360" HorizontalAlignment="Left"/>
        <InfoBar IsOpen="True" Severity="Informational"
                 Message="All files will be preserved inside a 'Merged_...' folder on the target partition."/>
    </StackPanel>
</UserControl>
